{
  "name": "Shedly",
  "short_name": "Shedly",
  "description": "A weekly review that gets your list shorter, not longer.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#EFF0F3",
  "theme_color": "#EFF0F3",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add an item",
      "short_name": "Add",
      "description": "Type something new into your list",
      "url": "./?add=1",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}